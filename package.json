{
  "name": "noesis",
  "version": "1.0.0",
  "description": "Persistent intelligence layer for AI coding agents — fuses memory, workflow, and auto-integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "noesis": "dist/cli/index.js"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:runtime": "node ./scripts/check-runtime.mjs",
    "preinstall": "node ./scripts/check-runtime.mjs",
    "prebuild": "node ./scripts/check-runtime.mjs",
    "build": "tsc",
    "predev": "node ./scripts/check-runtime.mjs",
    "dev": "tsc --watch",
    "pretest": "node ./scripts/check-runtime.mjs",
    "test": "vitest run",
    "pretest:watch": "node ./scripts/check-runtime.mjs",
    "test:watch": "vitest",
    "prelint": "node ./scripts/check-runtime.mjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "memory",
    "workflow",
    "ai",
    "coding-assistant",
    "intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "onnxruntime-node": "^1.24.3",
    "ulid": "^3.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
