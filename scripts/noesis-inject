    "",
    MANAGED_END,
  ].join("\n");
}

function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function readSeedContent(filePath, fallbackPaths = []) {
  try {
    return fs.readFileSync(filePath, "utf-8");
  } catch { /* keep looking */ }

  for (const fallbackPath of fallbackPaths) {
    try {
      return fs.readFileSync(fallbackPath, "utf-8");
    } catch { /* keep looking */ }
  }

  return "";
}

function injectIntoFile(filePath, managedContent, fallbackPaths = []) {
  let existing = readSeedContent(filePath, fallbackPaths);

  // Match either the legacy format  <!-- NOESIS:BEGIN --> ... <!-- NOESIS:END -->
  // or the rich format written by `noesis sync`:
  //   <!-- NOESIS:BEGIN adapter=X ... --> ... <!-- NOESIS:END adapter=X -->
  // Uses lazy .*? so the marker matching stops at the first "-->" rather than
  // consuming the "--" dashes as part of the content (which would break the match).
  //
  // Replace from the FIRST BEGIN to the LAST END so that any stale duplicate
  // sections (e.g. left from a previous format-mismatch run) are all removed
  // in a single pass.
  const BEGIN_RE = /<!-- NOESIS:BEGIN.*? -->/;
  const END_RE = /<!-- NOESIS:END.*? -->/g;

  const beginMatch = BEGIN_RE.exec(existing);
  let updated;
  if (beginMatch) {
    // Find the last occurrence of any NOESIS:END marker after the BEGIN
    let lastEnd = null;
    let m;
    const endSearch = existing.slice(beginMatch.index);
    const endRe = /<!-- NOESIS:END.*? -->/g;
    while ((m = endRe.exec(endSearch)) !== null) {
      lastEnd = { index: beginMatch.index + m.index, length: m[0].length };
    }
    if (lastEnd) {
      const before = existing.slice(0, beginMatch.index);
      const after = existing.slice(lastEnd.index + lastEnd.length);
      // Collapse any extra blank lines left by the removal
      updated = before + managedContent + after.replace(/^\n{2,}/, "\n");
    } else {
      // BEGIN found but no END — replace from BEGIN to end of file
      updated = existing.slice(0, beginMatch.index) + managedContent + "\n";
    }
  } else {
    const separator = existing.trim() ? "\n\n" : "";
    updated = existing + separator + managedContent + "\n";
  }

  fs.mkdirSync(path.dirname(filePath), { recursive: true, mode: 0o755 });
  fs.writeFileSync(filePath, updated, { mode: 0o644 });
}

function ensureCompatibilityBridge(bridgePath, canonicalPath) {
  const linkTarget = path.relative(path.dirname(bridgePath), canonicalPath) || path.basename(canonicalPath);
  fs.mkdirSync(path.dirname(bridgePath), { recursive: true, mode: 0o755 });

  if (fs.existsSync(bridgePath)) {
    const stat = fs.lstatSync(bridgePath);
    if (stat.isSymbolicLink()) {
      if (fs.readlinkSync(bridgePath) === linkTarget) {
        return bridgePath;
      }
      fs.unlinkSync(bridgePath);
    } else {
      fs.unlinkSync(bridgePath);
    }
  }

  try {
    fs.symlinkSync(linkTarget, bridgePath);
  } catch {
    fs.writeFileSync(bridgePath, fs.readFileSync(canonicalPath, "utf-8"), { mode: 0o644 });
  }

  return bridgePath;
}

function ensureGitignoreEntries(projectRoot, relativePaths) {
  if (!fs.existsSync(path.join(projectRoot, ".git"))) {
    return null;
  }

  const entries = [...new Set(relativePaths.map((entry) => {
    const normalized = entry.replace(/\\/g, "/").replace(/^\/+/, "");
    return `/${normalized}`;
  }))].sort();

  if (entries.length === 0) {
    return null;
  }

  const gitignorePath = path.join(projectRoot, ".gitignore");
  const existing = fs.existsSync(gitignorePath) ? fs.readFileSync(gitignorePath, "utf-8") : "";
  const block = [
    GITIGNORE_BLOCK_BEGIN,
    ...entries,
    GITIGNORE_BLOCK_END,
  ].join("\n");
  const blockRe = new RegExp(
    `${escapeRegExp(GITIGNORE_BLOCK_BEGIN)}[\\s\\S]*?${escapeRegExp(GITIGNORE_BLOCK_END)}`,
    "m",
  );

  let nextContent;
  if (blockRe.test(existing)) {
    nextContent = existing.replace(blockRe, block);
  } else {
    const separator = existing.trim() ? "\n\n" : "";
    nextContent = `${existing}${separator}${block}\n`;
  }

  if (nextContent === existing) {
    return null;
  }

  fs.writeFileSync(gitignorePath, nextContent, { mode: 0o644 });
  return gitignorePath;
}

function resolveProjectInstructionTarget(projectRoot, filePath) {
  const fileName = path.basename(filePath);
  const isProjectRootFile = path.resolve(path.dirname(filePath)) === path.resolve(projectRoot);

  if (!isProjectRootFile || !BRIDGED_CONTEXT_FILENAMES.has(fileName)) {
    return null;
  }

  return {
    bridgeFile: path.join(projectRoot, fileName),
    canonicalFile: path.join(projectRoot, CONTEXT_DIR, fileName),
    gitignoreEntries: [fileName, path.join(CONTEXT_DIR, fileName)],
  };
}

function injectProjectInstructionFile(projectRoot, filePath, managedContent, options = {}) {
  const persistentBridges = options.persistentBridges === true;
  const target = resolveProjectInstructionTarget(projectRoot, filePath);
  if (!target) {
    injectIntoFile(filePath, managedContent);
    return [filePath];
  }

  injectIntoFile(target.canonicalFile, managedContent, [target.bridgeFile]);
  const written = [target.canonicalFile];
  const gitignorePath = ensureGitignoreEntries(projectRoot, NOESIS_CONTEXT_GITIGNORE_ENTRIES);
  if (gitignorePath) {
    written.push(gitignorePath);
  }
  if (persistentBridges) {
    written.push(ensureCompatibilityBridge(target.bridgeFile, target.canonicalFile));
  }
  return written;
}

// ── Project detection ───────────────────────────────────────────

function findGitRoot(startDir) {
  try {
    return execFileSync("git", ["rev-parse", "--show-toplevel"], {
      cwd: startDir,
      encoding: "utf-8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return null;
  }
}

function resolveProjectRoot(startDir) {
  return findGitRoot(startDir) || path.resolve(startDir);
}

function normalizeComparablePath(pathLike) {
  try {
    return fs.realpathSync(pathLike);
  } catch {
    return path.resolve(pathLike);
  }
}

function getRegisteredProjects() {
  if (registeredProjectsCache) {
    return registeredProjectsCache;
  }

  try {
    const stdout = execNoesisCli(["--json", "project", "list"]);
    const parsed = JSON.parse(stdout);
    registeredProjectsCache = Array.isArray(parsed) ? parsed : [];
  } catch {
    registeredProjectsCache = [];
  }

  return registeredProjectsCache;
}

function isRegisteredProject(projectRoot) {
  const normalizedRoot = normalizeComparablePath(projectRoot);

  return getRegisteredProjects().some((project) => {
    if (!project || typeof project.path !== "string") {
      return false;
    }

    return normalizeComparablePath(project.path) === normalizedRoot;
  });
}

function detectProjectId(projectRoot) {
  try {
    const remote = execSync("git remote get-url origin 2>/dev/null", {
      cwd: projectRoot,
      encoding: "utf-8",
    }).trim();
    // Extract owner/repo from SSH or HTTPS URLs
    const match = remote.match(/[:/]([^/]+\/[^/.]+?)(?:\.git)?$/);
    if (match) return match[1];
  } catch { /* not a git repo or no remote */ }
  return null;
}

function hasAnyPath(dir, relativePaths) {
  return relativePaths.some((relativePath) => fs.existsSync(path.join(dir, relativePath)));
}

function detectAgents(dir, options = {}) {
  const useConfigMarkers = options.useConfigMarkers === true;
  const agents = [];

  // Outside a git project root, only explicit instruction files count as opt-in.
  const claudeMarkers = [
    "CLAUDE.md",
    path.join(CONTEXT_DIR, "CLAUDE.md"),
  ];
  if (useConfigMarkers) {
    claudeMarkers.unshift(".claude", ".clauderc", ".openclaw", "openclaw.yaml");
  }
  const hasClaudeProject = hasAnyPath(dir, claudeMarkers);
  if (hasClaudeProject) {
    agents.push({ id: "claude-code", file: path.join(dir, "CLAUDE.md") });
  }

  const agentsMarkers = [
    "AGENTS.md",
    path.join(CONTEXT_DIR, "AGENTS.md"),
  ];
  if (useConfigMarkers) {
    agentsMarkers.unshift(
      ".codex",
      "codex.json",
      ".opencode",
      path.join(".opencode", "config.json"),
      "opencode.json",
      ".kilocode",
      ".clinerules",
      ".cline",
    );
  }
  const hasAgentsProject = hasAnyPath(dir, agentsMarkers);
  if (hasAgentsProject) {
    agents.push({ id: "agents-md", file: path.join(dir, "AGENTS.md") });
  }

  return agents;
}

// ── Main ────────────────────────────────────────────────────────

async function main() {
  const args = process.argv.slice(2);
  const globalFlag = args.includes("--global");
  const persistentBridges = args.includes("--persistent-bridges");
  let projectId = null;
  const startDir = process.cwd();
  const gitRoot = findGitRoot(startDir);
  const projectRoot = gitRoot || path.resolve(startDir);

  const projectIdx = args.indexOf("--project");
  if (projectIdx !== -1 && args[projectIdx + 1]) {
    projectId = args[projectIdx + 1];
  }

  if (!projectId) {
    projectId = detectProjectId(projectRoot);
  }

  const registeredProject = isRegisteredProject(projectRoot);

  if (!globalFlag && !registeredProject) {
    return;
  }

  // Registered projects get the full agent surface. The wrappers decide which
  // runtime bridge to expose for the specific CLI being launched.
  const agents = registeredProject
    ? [
        { id: "claude-code", file: path.join(projectRoot, "CLAUDE.md") },
        { id: "agents-md", file: path.join(projectRoot, "AGENTS.md") },
      ]
    : [];

  if (agents.length === 0 && !globalFlag) {
    return;
  }

  // Query Noesis for context
  const taskDescription = projectId
    ? `Provide comprehensive intelligence context for work on ${projectId}`
    : `Provide comprehensive intelligence context for the project at ${projectRoot}`;

  let assembly;
  try {
    const daemonReady = await ensureDaemon();
    if (!daemonReady) {
      throw new Error("Could not start Noesis daemon");
    }

    assembly = await callNoesis("noesis.orchestrate", {
      request: taskDescription,
      project_id: projectId,
      token_budget: 50000,
    });
  } catch (err) {
    try {
      assembly = callNoesisViaCli(taskDescription, projectId);
    } catch (cliErr) {
      const primary = String(err && err.message || err || "unknown error");
      const fallback = String(cliErr && cliErr.message || cliErr || "unknown error");
      const detail = isIpcPermissionDenied(err)
        ? `${primary} (daemon IPC blocked; CLI fallback also failed)`
        : `${primary} (CLI fallback also failed)`;
      console.error(`Error querying Noesis: ${detail}`);
      console.error(`Fallback error: ${fallback}`);
      process.exit(1);
    }
  }

  const markdown = renderAssembly(assembly);
  if (!markdown) {
    console.log("Noesis returned no context. The knowledge base may be empty.");
    return;
  }

  const timestamp = new Date().toISOString();
  const managedContent = buildManagedContent(markdown, timestamp);

  const injected = new Set();

  // Inject into each detected agent's instruction file
  for (const agent of agents) {
    for (const writtenPath of injectProjectInstructionFile(projectRoot, agent.file, managedContent, { persistentBridges })) {
      injected.add(writtenPath);
    }
  }

  // Global CLAUDE.md
  if (globalFlag) {
    const globalClaude = path.join(os.homedir(), ".claude", "CLAUDE.md");
    injectIntoFile(globalClaude, managedContent);
    injected.add(globalClaude);
  }

  const contextLength = markdown.length;
  console.log(`Noesis context injected (${contextLength} chars, project: ${projectId || "auto"}, root: ${projectRoot})`);
  for (const f of injected) {
    console.log(`  -> ${f}`);
  }
}

main().catch((err) => {
  console.error(`Fatal: ${err.message}`);
  process.exit(1);
});
